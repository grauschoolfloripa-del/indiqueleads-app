# Vercel
.vercel/

# Environment variables
# .env é versionado temporariamente (repo privado) só para destravar o build na
# Vercel — contém apenas a chave "anon"/publicável do Supabase (feita para ser
# exposta no client, protegida por RLS, não é segredo). Remover do git assim que
# as env vars forem cadastradas direto no painel da Vercel.
.env.*
!.env.example

# Configuração local do Claude Code
.claude/

# Cache local do Supabase CLI
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Lockfile único: npm (package-lock.json). Dois lockfiles no mesmo repo
# fazem a Vercel escolher um deles de forma imprevisível.
bun.lock
